###  http://www.semanticweb.org/crist/ontologies/2026/7/untitled-ontology-116#inspection
:inspection rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :process
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :has_participant ;
                                                         owl:someValuesFrom :technician
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :process ;
            rdfs:comment "A process that has participant some technician." .


