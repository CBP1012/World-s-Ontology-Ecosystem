# =====================================================================
# Vehicle and Vehicle Manufacturer Ontology (VMO)
# OWL 2 DL — Turtle serialization
#
# Upper-level ontology: Basic Formal Ontology (BFO) 2020
# Mid-level support:    Relation Ontology (RO), Information Artifact
#                       Ontology (IAO)
#
# Competency questions this ontology is built to answer:
#   CQ1. What type(s) of vehicle does each manufacturer make?
#   CQ2. Where (facility / state / country) is each vehicle made?
#   CQ3. Which vehicle models are most popular per capita in the
#        United States (nationally and by state)?
#
# MODELING NOTES
# --------------
# * Vehicles are BFO:object. Vehicle *types* (e.g. Toyota RAV4) are OWL
#   classes whose instances are physical vehicles bearing VINs.
# * Manufacturers are BFO:object aggregate (an organization is an
#   aggregate of agents), bearing a Manufacturer Role (BFO:role) that is
#   realized in a Vehicle Manufacturing Process (BFO:process).
# * Manufacturing facilities are BFO:object; geopolitical regions are
#   BFO:site.
# * Popularity statistics are NOT qualities of vehicles. They are
#   Information Content Entities (BFO:generically dependent continuant)
#   that are *about* a model and *pertain to* a region. This keeps the
#   ontology honest: a registration rate is a datum, not a physical
#   property of a car.
# * OWL 2 DL punning is used deliberately: each model IRI (e.g. :FordF150)
#   denotes BOTH a class (the set of physical F-150s) AND an individual
#   (the model specification the statistics are about). This is legal
#   OWL 2 DL and keeps SPARQL over the statistics simple.
#
# DATA PROVENANCE WARNING
# -----------------------
# All registration counts, populations and per-capita rates below are
# ILLUSTRATIVE PLACEHOLDERS included to demonstrate the modeling pattern.
# Replace them with licensed figures (e.g. S&P Global Mobility / Experian
# vehicles-in-operation data + U.S. Census Bureau population estimates)
# before using this ontology for analysis. Each measurement individual
# carries a :hasDataProvenanceNote annotation.
# =====================================================================

@prefix :        <https://example.org/ontology/vmo#> .
@prefix vmo:     <https://example.org/ontology/vmo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .

# =====================================================================
# 1. ONTOLOGY HEADER AND IMPORTS
# =====================================================================

<https://example.org/ontology/vmo> a owl:Ontology ;
    dcterms:title "Vehicle and Vehicle Manufacturer Ontology (VMO)"@en ;
    dcterms:description """A BFO-2020-conformant domain ontology covering vehicles, the
organizations that manufacture them, the facilities and geopolitical regions in which they are
assembled, and per-capita adoption statistics for the United States."""@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionIRI <https://example.org/ontology/vmo/2026-08-05> ;
    owl:versionInfo "1.0.0" ;

    # --- REQUIRED IMPORTS -------------------------------------------
    # Basic Formal Ontology 2020 — ISO/IEC 21838-2 upper level.
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl> ;
    # Relation Ontology — supplies located in, has output, bearer of, etc.
    owl:imports <http://purl.obolibrary.org/obo/ro.owl> ;
    # Information Artifact Ontology — supplies information content entity,
    # is about, measurement datum, and the definition annotation properties.
    owl:imports <http://purl.obolibrary.org/obo/iao.owl> .

# --- OPTIONAL IMPORTS (uncomment as needed) --------------------------
# Common Core Ontologies (BFO-based mid-level; has Vehicle, Organization,
#   ManufacturingFacility, GeospatialRegion — align VMO classes to CCO if
#   you need interoperability with the CCO/BFO ecosystem):
#   owl:imports <https://www.commoncoreontologies.org/ArtifactOntology> ;
#   owl:imports <https://www.commoncoreontologies.org/AgentOntology> ;
#   owl:imports <https://www.commoncoreontologies.org/GeospatialOntology> ;
# Units of Measurement Ontology (if you want typed unit individuals):
#   owl:imports <http://purl.obolibrary.org/obo/uo.owl> ;
# Gazetteer (authoritative geopolitical individuals; very large file):
#   owl:imports <http://purl.obolibrary.org/obo/gaz.owl> ;

# =====================================================================
# 2. IMPORTED TERMS — declared here so the file parses stand-alone
#    (declarations merge harmlessly with the imported ontologies)
# =====================================================================

obo:BFO_0000001 a owl:Class ; rdfs:label "entity" .
obo:BFO_0000002 a owl:Class ; rdfs:label "continuant" .
obo:BFO_0000003 a owl:Class ; rdfs:label "occurrent" .
obo:BFO_0000004 a owl:Class ; rdfs:label "independent continuant" .
obo:BFO_0000015 a owl:Class ; rdfs:label "process" .
obo:BFO_0000016 a owl:Class ; rdfs:label "disposition" .
obo:BFO_0000017 a owl:Class ; rdfs:label "realizable entity" .
obo:BFO_0000019 a owl:Class ; rdfs:label "quality" .
obo:BFO_0000020 a owl:Class ; rdfs:label "specifically dependent continuant" .
obo:BFO_0000023 a owl:Class ; rdfs:label "role" .
obo:BFO_0000024 a owl:Class ; rdfs:label "fiat object part" .
obo:BFO_0000027 a owl:Class ; rdfs:label "object aggregate" .
obo:BFO_0000029 a owl:Class ; rdfs:label "site" .
obo:BFO_0000030 a owl:Class ; rdfs:label "object" .
obo:BFO_0000031 a owl:Class ; rdfs:label "generically dependent continuant" .
obo:BFO_0000034 a owl:Class ; rdfs:label "function" .
obo:BFO_0000040 a owl:Class ; rdfs:label "material entity" .
obo:IAO_0000030 a owl:Class ; rdfs:label "information content entity" .

obo:BFO_0000050 a owl:ObjectProperty ; rdfs:label "part of" .
obo:BFO_0000051 a owl:ObjectProperty ; rdfs:label "has part" .
obo:BFO_0000054 a owl:ObjectProperty ; rdfs:label "realized in" .
obo:BFO_0000055 a owl:ObjectProperty ; rdfs:label "realizes" .
obo:BFO_0000056 a owl:ObjectProperty ; rdfs:label "participates in" .
obo:BFO_0000057 a owl:ObjectProperty ; rdfs:label "has participant" .
obo:BFO_0000066 a owl:ObjectProperty ; rdfs:label "occurs in" .
obo:RO_0000052  a owl:ObjectProperty ; rdfs:label "characteristic of (inheres in)" .
obo:RO_0000053  a owl:ObjectProperty ; rdfs:label "bearer of" .
obo:RO_0001025  a owl:ObjectProperty ; rdfs:label "located in" .
obo:RO_0002234  a owl:ObjectProperty ; rdfs:label "has output" .
obo:RO_0002215  a owl:ObjectProperty ; rdfs:label "capable of" .
obo:IAO_0000136 a owl:ObjectProperty ; rdfs:label "is about" .

obo:IAO_0000115 a owl:AnnotationProperty ; rdfs:label "definition" .
obo:IAO_0000116 a owl:AnnotationProperty ; rdfs:label "editor note" .
obo:IAO_0000119 a owl:AnnotationProperty ; rdfs:label "definition source" .

# =====================================================================
# 3. LOCAL ANNOTATION PROPERTIES
# =====================================================================

:hasDataProvenanceNote a owl:AnnotationProperty ;
    rdfs:label "has data provenance note"@en ;
    obo:IAO_0000115 "Free-text note recording the source, vintage and reliability of an asserted datum."@en .

# =====================================================================
# 4. INDEPENDENT CONTINUANTS — MATERIAL ENTITIES
# =====================================================================

# ---- 4.1 Vehicles ---------------------------------------------------

:Vehicle a owl:Class ;
    rdfs:subClassOf obo:BFO_0000030 ;
    rdfs:label "Vehicle"@en ;
    obo:IAO_0000115 "An object that is the output of a manufacturing process and that has the function of transporting persons or cargo from one location to another."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty obo:RO_0000053 ;
        owl:someValuesFrom :TransportationFunction ] .

:MotorVehicle a owl:Class ;
    rdfs:subClassOf :Vehicle ;
    rdfs:label "Motor Vehicle"@en ;
    obo:IAO_0000115 "A vehicle that has as part a propulsion unit that supplies the motive power for its locomotion, and that is designed for operation on roads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty obo:BFO_0000051 ;
        owl:someValuesFrom :PropulsionUnit ] .

:Automobile a owl:Class ;
    rdfs:subClassOf :MotorVehicle ;
    rdfs:label "Automobile"@en ;
    skos:altLabel "Passenger Car"@en ;
    obo:IAO_0000115 "A motor vehicle whose primary function is the transportation of a small number of passengers, having an enclosed passenger cabin and an integrated (non-open) cargo area."@en .

:Sedan a owl:Class ; rdfs:subClassOf :Automobile ; rdfs:label "Sedan"@en .
:Coupe a owl:Class ; rdfs:subClassOf :Automobile ; rdfs:label "Coupe"@en .
:Hatchback a owl:Class ; rdfs:subClassOf :Automobile ; rdfs:label "Hatchback"@en .
:StationWagon a owl:Class ; rdfs:subClassOf :Automobile ; rdfs:label "Station Wagon"@en .
:Convertible a owl:Class ; rdfs:subClassOf :Automobile ; rdfs:label "Convertible"@en .

:SportUtilityVehicle a owl:Class ;
    rdfs:subClassOf :MotorVehicle ;
    rdfs:label "Sport Utility Vehicle"@en ;
    skos:altLabel "SUV"@en ;
    obo:IAO_0000115 "A motor vehicle with an elevated ride height and an enclosed unified passenger and cargo compartment, functioning to transport passengers and cargo over both paved and unpaved surfaces."@en .

:CrossoverUtilityVehicle a owl:Class ;
    rdfs:subClassOf :SportUtilityVehicle ;
    rdfs:label "Crossover Utility Vehicle"@en ;
    obo:IAO_0000115 "A sport utility vehicle built on a unibody (rather than body-on-frame) chassis."@en .

:CompactSportUtilityVehicle a owl:Class ; rdfs:subClassOf :SportUtilityVehicle ; rdfs:label "Compact Sport Utility Vehicle"@en .
:MidsizeSportUtilityVehicle a owl:Class ; rdfs:subClassOf :SportUtilityVehicle ; rdfs:label "Midsize Sport Utility Vehicle"@en .
:FullSizeSportUtilityVehicle a owl:Class ; rdfs:subClassOf :SportUtilityVehicle ; rdfs:label "Full-Size Sport Utility Vehicle"@en .

:PickupTruck a owl:Class ;
    rdfs:label "Pickup Truck"@en ;
    obo:IAO_0000115 "A motor vehicle having as fiat part an open cargo bed separated from the passenger cabin."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :MotorVehicle
                             [ a owl:Restriction ;
                               owl:onProperty obo:BFO_0000051 ;
                               owl:someValuesFrom :OpenCargoBed ] ) ] .

:LightDutyPickupTruck a owl:Class ; rdfs:subClassOf :PickupTruck ; rdfs:label "Light-Duty Pickup Truck"@en .
:MidsizePickupTruck a owl:Class ; rdfs:subClassOf :PickupTruck ; rdfs:label "Midsize Pickup Truck"@en .
:HeavyDutyPickupTruck a owl:Class ; rdfs:subClassOf :PickupTruck ; rdfs:label "Heavy-Duty Pickup Truck"@en .

:Van a owl:Class ; rdfs:subClassOf :MotorVehicle ; rdfs:label "Van"@en .
:Minivan a owl:Class ; rdfs:subClassOf :Van ; rdfs:label "Minivan"@en .
:CargoVan a owl:Class ; rdfs:subClassOf :Van ; rdfs:label "Cargo Van"@en .

:Motorcycle a owl:Class ; rdfs:subClassOf :MotorVehicle ; rdfs:label "Motorcycle"@en .
:Bus a owl:Class ; rdfs:subClassOf :MotorVehicle ; rdfs:label "Bus"@en .
:CommercialTruck a owl:Class ; rdfs:subClassOf :MotorVehicle ; rdfs:label "Commercial Truck"@en .

[] a owl:AllDisjointClasses ;
   owl:members ( :Automobile :SportUtilityVehicle :PickupTruck :Van :Motorcycle :Bus :CommercialTruck ) .

# ---- 4.2 Powertrain-defined vehicle classes (inferred by reasoner) ---

:BatteryElectricVehicle a owl:Class ;
    rdfs:label "Battery Electric Vehicle"@en ;
    skos:altLabel "BEV"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :MotorVehicle
                             [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom :TractionBattery ]
                             [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom :ElectricTractionMotor ]
                             [ a owl:Class ; owl:complementOf
                               [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom :InternalCombustionEngine ] ] ) ] .

:HybridElectricVehicle a owl:Class ;
    rdfs:label "Hybrid Electric Vehicle"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :MotorVehicle
                             [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom :InternalCombustionEngine ]
                             [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom :ElectricTractionMotor ] ) ] .

:InternalCombustionVehicle a owl:Class ;
    rdfs:label "Internal Combustion Vehicle"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :MotorVehicle
                             [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom :InternalCombustionEngine ]
                             [ a owl:Class ; owl:complementOf
                               [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom :ElectricTractionMotor ] ] ) ] .

:FuelCellElectricVehicle a owl:Class ;
    rdfs:label "Fuel Cell Electric Vehicle"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :MotorVehicle
                             [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom :FuelCellStack ] ) ] .

# ---- 4.3 Vehicle components ----------------------------------------

:VehicleComponent a owl:Class ;
    rdfs:subClassOf obo:BFO_0000030 ;
    rdfs:label "Vehicle Component"@en ;
    obo:IAO_0000115 "An object that is designed to be a part of a vehicle."@en .

:PropulsionUnit a owl:Class ; rdfs:subClassOf :VehicleComponent ; rdfs:label "Propulsion Unit"@en .
:InternalCombustionEngine a owl:Class ; rdfs:subClassOf :PropulsionUnit ; rdfs:label "Internal Combustion Engine"@en .
:ElectricTractionMotor a owl:Class ; rdfs:subClassOf :PropulsionUnit ; rdfs:label "Electric Traction Motor"@en .
:FuelCellStack a owl:Class ; rdfs:subClassOf :VehicleComponent ; rdfs:label "Fuel Cell Stack"@en .
:TractionBattery a owl:Class ; rdfs:subClassOf :VehicleComponent ; rdfs:label "Traction Battery"@en .
:Chassis a owl:Class ; rdfs:subClassOf :VehicleComponent ; rdfs:label "Chassis"@en .
:UnibodyChassis a owl:Class ; rdfs:subClassOf :Chassis ; rdfs:label "Unibody Chassis"@en .
:BodyOnFrameChassis a owl:Class ; rdfs:subClassOf :Chassis ; rdfs:label "Body-on-Frame Chassis"@en .

:PassengerCabin a owl:Class ;
    rdfs:subClassOf obo:BFO_0000024 ;
    rdfs:label "Passenger Cabin"@en ;
    obo:IAO_0000115 "A fiat object part of a vehicle that is bounded by the vehicle body and functions to contain seated occupants."@en .

:OpenCargoBed a owl:Class ;
    rdfs:subClassOf obo:BFO_0000024 ;
    rdfs:label "Open Cargo Bed"@en ;
    obo:IAO_0000115 "A fiat object part of a vehicle consisting of an uncovered load-bearing platform bounded by side walls and a tailgate, physically separated from the passenger cabin."@en .

:CrossoverUtilityVehicle rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom :UnibodyChassis ] .

# ---- 4.4 Organizations ---------------------------------------------

:Organization a owl:Class ;
    rdfs:subClassOf obo:BFO_0000027 ;
    rdfs:label "Organization"@en ;
    obo:IAO_0000115 "An object aggregate whose member parts are persons who bear roles that are realized in processes carried out to achieve the objectives of the aggregate."@en .

:CommercialOrganization a owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Commercial Organization"@en .

:VehicleManufacturer a owl:Class ;
    rdfs:subClassOf :CommercialOrganization ;
    rdfs:label "Vehicle Manufacturer"@en ;
    obo:IAO_0000115 "A commercial organization that bears a manufacturer role realized in vehicle manufacturing processes that have vehicles as output."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty obo:RO_0000053 ;
        owl:someValuesFrom :VehicleManufacturerRole ] .

:AutomotiveBrandDivision a owl:Class ;
    rdfs:subClassOf :Organization ;
    rdfs:label "Automotive Brand Division"@en ;
    obo:IAO_0000115 "An organization that is a proper part of a vehicle manufacturer and under whose marque a subset of that manufacturer's vehicles is marketed."@en .

# ---- 4.5 Facilities -------------------------------------------------

:ManufacturingFacility a owl:Class ;
    rdfs:subClassOf obo:BFO_0000030 ;
    rdfs:label "Manufacturing Facility"@en ;
    obo:IAO_0000115 "An object designed to house and support manufacturing processes."@en .

:VehicleAssemblyPlant a owl:Class ;
    rdfs:subClassOf :ManufacturingFacility ;
    rdfs:label "Vehicle Assembly Plant"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty obo:RO_0002215 ;
        owl:someValuesFrom :VehicleAssemblyProcess ] .

:PowertrainPlant a owl:Class ;
    rdfs:subClassOf :ManufacturingFacility ;
    rdfs:label "Powertrain Plant"@en ;
    obo:IAO_0000116 "Retained for extension: facilities producing engines, batteries and transmissions."@en .

# =====================================================================
# 5. IMMATERIAL ENTITIES — SITES AND GEOPOLITICAL REGIONS
# =====================================================================

:GeopoliticalRegion a owl:Class ;
    rdfs:subClassOf obo:BFO_0000029 ;
    rdfs:label "Geopolitical Region"@en ;
    obo:IAO_0000115 "A site whose boundaries are determined by a political entity with jurisdiction over it."@en .

:Country a owl:Class ; rdfs:subClassOf :GeopoliticalRegion ; rdfs:label "Country"@en .
:StateOrProvince a owl:Class ; rdfs:subClassOf :GeopoliticalRegion ; rdfs:label "State or Province"@en .
:City a owl:Class ; rdfs:subClassOf :GeopoliticalRegion ; rdfs:label "City"@en .

# =====================================================================
# 6. REALIZABLE ENTITIES — ROLES, FUNCTIONS, DISPOSITIONS
# =====================================================================

:VehicleManufacturerRole a owl:Class ;
    rdfs:subClassOf obo:BFO_0000023 ;
    rdfs:label "Vehicle Manufacturer Role"@en ;
    obo:IAO_0000115 "A role borne by an organization that is realized in vehicle manufacturing processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty obo:BFO_0000054 ;
        owl:someValuesFrom :VehicleManufacturingProcess ] .

:VehicleOwnerRole a owl:Class ; rdfs:subClassOf obo:BFO_0000023 ; rdfs:label "Vehicle Owner Role"@en .

:TransportationFunction a owl:Class ;
    rdfs:subClassOf obo:BFO_0000034 ;
    rdfs:label "Transportation Function"@en ;
    obo:IAO_0000115 "A function borne by a material entity that is realized in a process of moving persons or cargo from one location to another."@en .

:PassengerTransportationFunction a owl:Class ; rdfs:subClassOf :TransportationFunction ; rdfs:label "Passenger Transportation Function"@en .
:CargoTransportationFunction a owl:Class ; rdfs:subClassOf :TransportationFunction ; rdfs:label "Cargo Transportation Function"@en .

:OffRoadCapability a owl:Class ;
    rdfs:subClassOf obo:BFO_0000016 ;
    rdfs:label "Off-Road Capability"@en ;
    obo:IAO_0000115 "A disposition of a vehicle to traverse unpaved terrain without loss of function."@en .

# =====================================================================
# 7. OCCURRENTS — PROCESSES
# =====================================================================

:VehicleManufacturingProcess a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ;
    rdfs:label "Vehicle Manufacturing Process"@en ;
    obo:IAO_0000115 "A planned process that has a vehicle manufacturer as participant, occurs in a manufacturing facility, and has a vehicle as output."@en ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:RO_0002234 ; owl:someValuesFrom :Vehicle ] ,
                    [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom :VehicleManufacturer ] ,
                    [ a owl:Restriction ; owl:onProperty obo:BFO_0000066 ; owl:someValuesFrom :ManufacturingFacility ] .

:VehicleAssemblyProcess a owl:Class ;
    rdfs:subClassOf :VehicleManufacturingProcess ;
    rdfs:label "Vehicle Assembly Process"@en .

:VehicleRegistrationProcess a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ;
    rdfs:label "Vehicle Registration Process"@en ;
    obo:IAO_0000115 "A process in which a governmental body records a vehicle as licensed for road use within a geopolitical region."@en .

# =====================================================================
# 8. GENERICALLY DEPENDENT CONTINUANTS — INFORMATION ENTITIES
# =====================================================================

:VehicleModelSpecification a owl:Class ;
    rdfs:subClassOf obo:IAO_0000030 ;
    rdfs:label "Vehicle Model Specification"@en ;
    obo:IAO_0000115 "An information content entity that prescribes the design of a class of vehicles marketed under a single model designation."@en .

:Marque a owl:Class ;
    rdfs:subClassOf obo:IAO_0000030 ;
    rdfs:label "Marque"@en ;
    obo:IAO_0000115 "An information content entity that designates the brand under which a manufacturer markets vehicles."@en .

:MeasurementDatum a owl:Class ;
    rdfs:subClassOf obo:IAO_0000030 ;
    rdfs:label "Measurement Datum"@en ;
    obo:IAO_0000115 "An information content entity that is the output of a measurement process and is about some entity."@en .

:VehicleRegistrationCountDatum a owl:Class ;
    rdfs:subClassOf :MeasurementDatum ;
    rdfs:label "Vehicle Registration Count Datum"@en ;
    obo:IAO_0000115 "A measurement datum recording the number of vehicles of a given model registered within a geopolitical region during a specified year."@en .

:PerCapitaAdoptionRateDatum a owl:Class ;
    rdfs:subClassOf :MeasurementDatum ;
    rdfs:label "Per Capita Adoption Rate Datum"@en ;
    obo:IAO_0000115 "A measurement datum recording the ratio of registered vehicles of a given model to the resident population of a geopolitical region, expressed per one thousand persons."@en ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :pertainsToRegion ; owl:someValuesFrom :GeopoliticalRegion ] .

# --- Defined class: high per-capita adoption in the United States ----
# Uses an OWL 2 datatype facet so a reasoner can classify measurements.

:HighPerCapitaAdoptionInUnitedStates a owl:Class ;
    rdfs:label "High Per Capita Adoption Datum (United States)"@en ;
    obo:IAO_0000115 "A per capita adoption rate datum pertaining to the United States whose value is at least 2.0 registered vehicles per one thousand residents."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :PerCapitaAdoptionRateDatum
                             [ a owl:Restriction ; owl:onProperty :pertainsToRegion ; owl:hasValue :UnitedStatesOfAmerica ]
                             [ a owl:Restriction ; owl:onProperty :hasVehiclesPerThousandPersons ;
                               owl:someValuesFrom [ a rdfs:Datatype ;
                                   owl:onDatatype xsd:decimal ;
                                   owl:withRestrictions ( [ xsd:minInclusive "2.0"^^xsd:decimal ] ) ] ] ) ] .

# =====================================================================
# 9. OBJECT PROPERTIES
# =====================================================================

:manufacturedBy a owl:ObjectProperty ;
    rdfs:label "manufactured by"@en ;
    rdfs:domain :Vehicle ; rdfs:range :VehicleManufacturer ;
    owl:inverseOf :manufactures ;
    obo:IAO_0000115 "Relates a vehicle to the organization that participated in the manufacturing process having that vehicle as output. Relational shortcut for the process-based pattern."@en .

:manufactures a owl:ObjectProperty ;
    rdfs:label "manufactures"@en ;
    rdfs:domain :VehicleManufacturer ; rdfs:range :Vehicle .

:producesModel a owl:ObjectProperty ;
    rdfs:label "produces model"@en ;
    rdfs:domain :VehicleManufacturer ; rdfs:range :VehicleModelSpecification ;
    owl:inverseOf :modelProducedBy ;
    obo:IAO_0000115 "Relates a manufacturer to a model specification it puts into production. (Answers CQ1 at the type level.)"@en .

:modelProducedBy a owl:ObjectProperty ; rdfs:label "model produced by"@en .

:hasDivision a owl:ObjectProperty ;
    rdfs:label "has division"@en ;
    rdfs:subPropertyOf obo:BFO_0000051 ;
    rdfs:domain :Organization ; rdfs:range :AutomotiveBrandDivision .

:operatesFacility a owl:ObjectProperty ;
    rdfs:label "operates facility"@en ;
    rdfs:domain :Organization ; rdfs:range :ManufacturingFacility .

:assembledAtFacility a owl:ObjectProperty ;
    rdfs:label "assembled at facility"@en ;
    rdfs:range :ManufacturingFacility ;
    obo:IAO_0000115 "Relates a vehicle (or model specification) to the facility in which its assembly process occurs. (Answers CQ2.)"@en .

:facilityLocatedIn a owl:ObjectProperty ;
    rdfs:label "facility located in"@en ;
    rdfs:subPropertyOf obo:RO_0001025 ;
    rdfs:domain :ManufacturingFacility ; rdfs:range :GeopoliticalRegion .

:regionPartOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "region part of"@en ;
    rdfs:subPropertyOf obo:BFO_0000050 ;
    rdfs:domain :GeopoliticalRegion ; rdfs:range :GeopoliticalRegion .

# City -> State -> Country propagation for facility location.
:facilityLocatedIn owl:propertyChainAxiom ( :facilityLocatedIn :regionPartOf ) .

:assembledInRegion a owl:ObjectProperty ;
    rdfs:label "assembled in region"@en ;
    rdfs:range :GeopoliticalRegion ;
    obo:IAO_0000115 "Inferred from the facility of assembly and that facility's location."@en ;
    owl:propertyChainAxiom ( :assembledAtFacility :facilityLocatedIn ) .

:manufacturesInRegion a owl:ObjectProperty ;
    rdfs:label "manufactures in region"@en ;
    rdfs:domain :VehicleManufacturer ; rdfs:range :GeopoliticalRegion ;
    owl:propertyChainAxiom ( :producesModel :assembledAtFacility :facilityLocatedIn ) .

:headquarteredIn a owl:ObjectProperty ;
    rdfs:label "headquartered in"@en ;
    rdfs:domain :Organization ; rdfs:range :GeopoliticalRegion .

:conformsToModel a owl:ObjectProperty ;
    rdfs:label "conforms to model"@en ;
    rdfs:domain :Vehicle ; rdfs:range :VehicleModelSpecification .

:hasMarque a owl:ObjectProperty ;
    rdfs:label "has marque"@en ;
    rdfs:range :Marque .

:pertainsToRegion a owl:ObjectProperty ;
    rdfs:label "pertains to region"@en ;
    rdfs:domain :MeasurementDatum ; rdfs:range :GeopoliticalRegion .

:isAboutModel a owl:ObjectProperty ;
    rdfs:label "is about model"@en ;
    rdfs:subPropertyOf obo:IAO_0000136 ;
    rdfs:domain :MeasurementDatum ; rdfs:range :VehicleModelSpecification .

# =====================================================================
# 10. DATA PROPERTIES
# =====================================================================

:hasVehicleIdentificationNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has vehicle identification number"@en ;
    rdfs:domain :Vehicle ; rdfs:range xsd:string .

:hasModelYear a owl:DatatypeProperty ; rdfs:label "has model year"@en ; rdfs:range xsd:gYear .
:hasSeatingCapacity a owl:DatatypeProperty ; rdfs:label "has seating capacity"@en ; rdfs:range xsd:nonNegativeInteger .
:hasCurbWeightInKilograms a owl:DatatypeProperty ; rdfs:label "has curb weight in kilograms"@en ; rdfs:range xsd:decimal .
:hasBaseMSRPInUSDollars a owl:DatatypeProperty ; rdfs:label "has base MSRP in US dollars"@en ; rdfs:range xsd:decimal .
:hasModelDesignation a owl:DatatypeProperty ; rdfs:label "has model designation"@en ; rdfs:range xsd:string .

:hasRegistrationCount a owl:DatatypeProperty ;
    rdfs:label "has registration count"@en ;
    rdfs:domain :MeasurementDatum ; rdfs:range xsd:nonNegativeInteger .

:hasReferencePopulationCount a owl:DatatypeProperty ;
    rdfs:label "has reference population count"@en ;
    rdfs:domain :MeasurementDatum ; rdfs:range xsd:nonNegativeInteger .

:hasVehiclesPerThousandPersons a owl:DatatypeProperty ;
    rdfs:label "has vehicles per thousand persons"@en ;
    rdfs:domain :PerCapitaAdoptionRateDatum ; rdfs:range xsd:decimal ;
    obo:IAO_0000115 "The quotient of registration count and reference population, multiplied by 1000. (Answers CQ3.)"@en .

:hasMeasurementYear a owl:DatatypeProperty ;
    rdfs:label "has measurement year"@en ;
    rdfs:domain :MeasurementDatum ; rdfs:range xsd:gYear .

:hasNationalPerCapitaRank a owl:DatatypeProperty ;
    rdfs:label "has national per capita rank"@en ;
    rdfs:domain :MeasurementDatum ; rdfs:range xsd:positiveInteger .

