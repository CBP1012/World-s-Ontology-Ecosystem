# =====================================================================
# 14. VEHICLE MODELS
#
# Each model IRI is punned: a CLASS (all physical vehicles of that model)
# and an INDIVIDUAL of type :VehicleModelSpecification (what the
# statistics in section 15 are about).
# =====================================================================

# ---- Ford F-150 -----------------------------------------------------
:FordF150 a owl:Class ;
    rdfs:subClassOf :LightDutyPickupTruck , :InternalCombustionVehicle ,
        [ a owl:Restriction ; owl:onProperty :manufacturedBy ; owl:hasValue :FordMotorCompany ] ,
        [ a owl:Restriction ; owl:onProperty :assembledAtFacility ;
          owl:someValuesFrom [ a owl:Class ; owl:oneOf ( :DearbornTruckPlant :KansasCityAssemblyPlant ) ] ] ;
    rdfs:label "Ford F-150"@en .
:FordF150 a owl:NamedIndividual , :VehicleModelSpecification ;
    :hasModelDesignation "F-150" ;
    :assembledAtFacility :DearbornTruckPlant , :KansasCityAssemblyPlant .
:FordMotorCompany :producesModel :FordF150 .

# ---- Ford Mustang Mach-E -------------------------------------------
:FordMustangMachE a owl:Class ;
    rdfs:subClassOf :CrossoverUtilityVehicle , :BatteryElectricVehicle ,
        [ a owl:Restriction ; owl:onProperty :manufacturedBy ; owl:hasValue :FordMotorCompany ] ;
    rdfs:label "Ford Mustang Mach-E"@en .
:FordMustangMachE a owl:NamedIndividual , :VehicleModelSpecification ;
    :hasModelDesignation "Mustang Mach-E" ;
    :assembledAtFacility :CuautitlanAssemblyPlant .
:FordMotorCompany :producesModel :FordMustangMachE .

