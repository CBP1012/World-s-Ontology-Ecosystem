# 15. PER-CAPITA POPULARITY DATA (UNITED STATES)
#
# *** ALL VALUES BELOW ARE ILLUSTRATIVE PLACEHOLDERS ***
# Replace with licensed vehicles-in-operation data before analysis.
# =====================================================================

:PerCapita_FordF150_US_2024 a owl:NamedIndividual , :PerCapitaAdoptionRateDatum ;
    rdfs:label "Ford F-150 per capita adoption, United States, 2024"@en ;
    :isAboutModel :FordF150 ;
    :pertainsToRegion :UnitedStatesOfAmerica ;
    :hasRegistrationCount 16000000 ;
    :hasReferencePopulationCount 335000000 ;
    :hasVehiclesPerThousandPersons "47.8"^^xsd:decimal ;
    :hasMeasurementYear "2024"^^xsd:gYear ;
    :hasNationalPerCapitaRank 1 ;
    :hasDataProvenanceNote "PLACEHOLDER VALUE — replace with S&P Global Mobility vehicles-in-operation counts and U.S. Census Bureau population estimates." .

:PerCapita_ChevroletSilverado_US_2024 a owl:NamedIndividual , :PerCapitaAdoptionRateDatum ;
