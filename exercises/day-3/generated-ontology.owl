# =====================================================================
# 16. DEFINED CLASSES FOR MANUFACTURER TYPING (CQ1 via reasoner)
# =====================================================================

:PickupTruckManufacturer a owl:Class ;
    rdfs:label "Pickup Truck Manufacturer"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :VehicleManufacturer
                             [ a owl:Restriction ; owl:onProperty :manufactures ; owl:someValuesFrom :PickupTruck ] ) ] .

:SportUtilityVehicleManufacturer a owl:Class ;
    rdfs:label "Sport Utility Vehicle Manufacturer"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :VehicleManufacturer
                             [ a owl:Restriction ; owl:onProperty :manufactures ; owl:someValuesFrom :SportUtilityVehicle ] ) ] .

:BatteryElectricVehicleManufacturer a owl:Class ;
    rdfs:label "Battery Electric Vehicle Manufacturer"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :VehicleManufacturer
                             [ a owl:Restriction ; owl:onProperty :manufactures ; owl:someValuesFrom :BatteryElectricVehicle ] ) ] .

:UnitedStatesAssembledVehicle a owl:Class ;
    rdfs:label "United States Assembled Vehicle"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Vehicle
                             [ a owl:Restriction ; owl:onProperty :assembledInRegion ; owl:hasValue :UnitedStatesOfAmerica ] ) ] .

# =====================================================================
# 17. EXAMPLE SPARQL QUERIES (documentation only)
#
# CQ1 — What type of vehicle does each manufacturer make?
#   SELECT ?mfrLabel ?modelLabel ?typeLabel WHERE {
#     ?mfr a vmo:VehicleManufacturer ; rdfs:label ?mfrLabel ;
#          vmo:producesModel ?model .
#     ?model rdfs:label ?modelLabel ; rdfs:subClassOf ?type .
#     ?type rdfs:subClassOf* vmo:MotorVehicle ; rdfs:label ?typeLabel .
#   } ORDER BY ?mfrLabel
#
# CQ2 — Where is each model assembled (plant, state, country)?
#   SELECT ?modelLabel ?plantLabel ?regionLabel WHERE {
#     ?model a vmo:VehicleModelSpecification ; rdfs:label ?modelLabel ;
#            vmo:assembledAtFacility ?plant .
#     ?plant rdfs:label ?plantLabel ; vmo:facilityLocatedIn ?region .
#     ?region rdfs:label ?regionLabel .
#   }
#
# CQ2b — Which manufacturers build vehicles inside the United States?
#   SELECT DISTINCT ?mfrLabel WHERE {
#     ?mfr rdfs:label ?mfrLabel ; vmo:producesModel ?model .
#     ?model vmo:assembledAtFacility ?plant .
#     ?plant vmo:facilityLocatedIn/vmo:regionPartOf* vmo:UnitedStatesOfAmerica .
#   }
#
# CQ3 — Most popular models per capita in the United States:
#   SELECT ?modelLabel ?rate WHERE {
#     ?d a vmo:PerCapitaAdoptionRateDatum ;
#        vmo:pertainsToRegion vmo:UnitedStatesOfAmerica ;
#        vmo:isAboutModel ?model ;
#        vmo:hasVehiclesPerThousandPersons ?rate ;
#        vmo:hasMeasurementYear "2024"^^xsd:gYear .
#     ?model rdfs:label ?modelLabel .
#   } ORDER BY DESC(?rate) LIMIT 10
#
# CQ3b — Most popular model per capita in each U.S. state:
#   SELECT ?stateLabel ?modelLabel (MAX(?rate) AS ?topRate) WHERE {
#     ?d vmo:pertainsToRegion ?state ; vmo:isAboutModel ?model ;
#        vmo:hasVehiclesPerThousandPersons ?rate .
#     ?state a vmo:StateOrProvince ; rdfs:label ?stateLabel ;
#            vmo:regionPartOf vmo:UnitedStatesOfAmerica .
#     ?model rdfs:label ?modelLabel .
#   } GROUP BY ?stateLabel ?modelLabel ORDER BY DESC(?topRate)
#
# DL query equivalents (Protégé, with HermiT/ELK running):
#   vmo:PickupTruckManufacturer            -> manufacturers of pickups
#   vmo:HighPerCapitaAdoptionInUnitedStates -> high-adoption data items
#   vmo:UnitedStatesAssembledVehicle        -> U.S.-built vehicles
# =====================================================================
